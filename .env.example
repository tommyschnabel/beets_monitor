# Base URL of the actions dashboard, used to proxy beets maintenance
# commands (/import, /update, /bad) to it
ACTIONS_BASE_URL=http://actions_dashboard:5001

# Set to 1 to enable the Flask debug server (never in production - the
# Werkzeug debugger allows remote code execution)
FLASK_DEBUG=0

# Discord webhook used by the backup scripts (config/backups/common.sh)
BACKUP_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
