# Base URL of the beets web plugin API (required)
BEETS_BASE_URL=beets:8337

# User agent sent to the MusicBrainz API. MusicBrainz asks for contact info
# here; include an email or URL they can reach you at.
MUSICBRAINZ_USER_AGENT=beets_monitor/0.0.1 ( your-email@example.com )

# slskd (Soulseek) base URL, used by the /slskd_search endpoint. Leave unset
# to disable that endpoint.
SLSKD_URL=http://slskd:5030
SLSKD_API_KEY=

# Path prefixes used when exporting playlists (see build_playlists in
# catalog.py). Beets returns item paths relative to its music directory;
# these prefixes translate that relative path into an absolute path each
# consumer expects.
PLEX_MUSIC_PREFIX=/music
STRAWBERRY_MUSIC_PREFIX=/music
PLAYLIST_DIR=/playlists

# Plex integration, used for playlist export via ratingKey resolution
PLEX_URL=http://plex:32400
PLEX_TOKEN=
PLEX_LIBRARY=Music

# Set to 1 to enable the Flask debug server (never in production - the
# Werkzeug debugger allows remote code execution)
FLASK_DEBUG=0
